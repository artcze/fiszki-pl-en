---
import Layout from "@/layouts/Layout.astro";
import FlashcardsApp from "@/components/flashcards/FlashcardsApp";

const { user } = Astro.locals;
---

<Layout title="Moje fiszki" lang="pl">
  <div class="bg-cosmic min-h-screen text-white">
    <div class="mx-auto max-w-5xl px-4 py-6 sm:px-6 sm:py-8">
      <header class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h1
            class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent sm:text-4xl"
          >
            Moje fiszki
          </h1>
          <p class="mt-1 text-sm text-blue-100/60">
            Zalogowano jako <span class="text-blue-100/90">{user?.email}</span>
          </p>
        </div>
        <form method="POST" action="/api/auth/signout">
          <button
            type="submit"
            class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors outline-none hover:bg-white/20 focus-visible:ring-2 focus-visible:ring-purple-400"
          >
            Wyloguj się
          </button>
        </form>
      </header>

      <main>
        <FlashcardsApp client:load />
      </main>
    </div>
  </div>
</Layout>
